# --------------------------------------------
# REQUIRED: BASIC APP SETTINGS
# --------------------------------------------
NODE_ENV=production
PORT=8000

# --------------------------------------------
# REQUIRED: DATABASE SETTINGS
# --------------------------------------------
DATABASE_URL=postgresql://postgres:123@localhost:5432/backend_boilerplate?schema=public

# --------------------------------------------
# REQUIRED: AUTH SETTINGS
# --------------------------------------------
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:8000

# Google OAuth redirect URI: {BETTER_AUTH_URL}/api/v1/auth/callback/google
# Local sample, when BETTER_AUTH_URL is http://localhost:8000:
# http://localhost:8000/api/v1/auth/callback/google
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Displayed in front of the workspace slug. Not a route and not a URL.
# Production host is undecided. The trailing slash is kept.
WORKSPACE_URL_PREFIX=handshakes.cards/

# --------------------------------------------
# OPTIONAL: SECURITY HEADER SETTINGS
# --------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Parent domain of the client and the API, so both share the session cookie.
# Production sample, for postbox.geoplanph.com and postbox-api.geoplanph.com:
# COOKIE_DOMAIN=geoplanph.com
# Cookies then carry Domain, Secure and SameSite=Lax. It only applies when
# BETTER_AUTH_URL is https and its host is inside this domain, so localhost keeps
# host-only cookies. Leave it empty locally.
COOKIE_DOMAIN=

# --------------------------------------------
# OPTIONAL: MEDIA STORAGE (Cloudflare R2)
# Presigned uploads return 503 until every value is set.
# The browser PUTs straight to the bucket. The bucket CORS rule has to allow
# http://localhost:4200, method PUT, and the content-type and content-length headers.
# --------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=https://media.example.com

