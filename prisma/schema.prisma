generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  @@map("users")
}

model Session {
  id                   String   @id
  expiresAt            DateTime @map("expires_at")
  token                String   @unique
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  userId               String   @map("user_id")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?  @map("active_organization_id")

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model Organization {
  id               String            @id
  name             String
  slug             String            @unique
  logo             String?
  website          String?
  createdAt        DateTime          @map("created_at")
  metadata         String?
  members          Member[]
  invitations      Invitation[]
  apiKeys          ApiKey[]
  fieldDefinitions FieldDefinition[]
  leads            Lead[]
  contentEntries   ContentEntry[]
  media            Media[]
  contentAccess    ContentAccess?

  @@map("organizations")
}

model Member {
  id             String       @id
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @unique @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime     @map("created_at")

  @@index([organizationId])
  @@map("members")
}

model Invitation {
  id             String       @id
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime     @map("expires_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  inviterId      String       @map("inviter_id")
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}
// Owned by the Better Auth API key plugin. Field names are the plugin's; the
// column names are the ones the table already had. `referenceId` is the owning
// organization, because the plugin is configured with references: "organization".
model ApiKey {
  id                  String       @id
  configId            String       @map("config_id")
  name                String
  prefix              String?
  start               String?      @map("key_prefix")
  key                 String       @unique @map("key_hash")
  referenceId         String       @map("organization_id")
  organization        Organization @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  enabled             Boolean      @default(true)
  rateLimitEnabled    Boolean      @default(true) @map("rate_limit_enabled")
  rateLimitTimeWindow Int?         @map("rate_limit_time_window")
  rateLimitMax        Int?         @map("rate_limit_max")
  requestCount        Int          @default(0) @map("request_count")
  remaining           Int?
  refillInterval      Int?         @map("refill_interval")
  refillAmount        Int?         @map("refill_amount")
  lastRefillAt        DateTime?    @map("last_refill_at")
  lastRequest         DateTime?    @map("last_used_at")
  expiresAt           DateTime?    @map("expires_at")
  permissions         String?
  metadata            String?
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  @@index([referenceId])
  @@index([configId])
  @@map("api_keys")
}

// The record types whose attributes are described by field definitions.
enum FieldCollection {
  lead

  @@map("field_collection")
}

enum FieldType {
  text
  long_text
  number
  select
  url
  date
  datetime

  @@map("field_type")
}

model FieldDefinition {
  id             String          @id @default(uuid(7))
  organizationId String          @map("organization_id")
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  collection     FieldCollection
  key            String
  label          String
  type           FieldType
  options        String[]        @default([])
  isRequired     Boolean         @default(false) @map("is_required")
  isReadOnly     Boolean         @default(false) @map("is_read_only")
  isSystem       Boolean         @default(false) @map("is_system")
  position       Int
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  leadValues     LeadValue[]

  @@unique([organizationId, collection, key])
  @@index([organizationId, collection, position])
  @@map("field_definitions")
}

model Lead {
  id             String       @id @default(uuid(7))
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values         LeadValue[]
  // Archive is its own axis, not a stage: an archived lead keeps the status it
  // reached and only leaves the inbox.
  isArchived     Boolean      @default(false) @map("is_archived")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([organizationId, isArchived, createdAt])
  @@map("leads")
}

// One row per filled field. Deleting a field definition deletes its values.
model LeadValue {
  leadId  String          @map("lead_id")
  lead    Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fieldId String          @map("field_id")
  field   FieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value   Json

  @@id([leadId, fieldId])
  @@index([fieldId])
  @@map("lead_values")
}

enum ContentKind {
  post
  page

  @@map("content_kind")
}

enum ContentStatus {
  draft
  published

  @@map("content_status")
}

model ContentEntry {
  id              String        @id @default(uuid(7))
  organizationId  String        @map("organization_id")
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind            ContentKind
  title           String
  slug            String
  excerpt         String        @default("")
  metaTitle       String        @default("") @map("meta_title")
  metaDescription String        @default("") @map("meta_description")
  ogImageId       String?       @map("og_image_id")
  ogImage         Media?        @relation("EntryOgImage", fields: [ogImageId], references: [id], onDelete: Restrict)
  coverImageId    String?       @map("cover_image_id")
  coverImage      Media?        @relation("EntryCoverImage", fields: [coverImageId], references: [id], onDelete: Restrict)
  status          ContentStatus @default(draft)
  publishedAt     DateTime?     @map("published_at")
  blocks          Json
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@unique([organizationId, slug])
  @@index([organizationId, status, kind, updatedAt])
  @@index([organizationId, status, publishedAt])
  @@map("content_entries")
}

model Media {
  id             String         @id @default(uuid(7))
  organizationId String         @map("organization_id")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  storageKey     String         @unique @map("storage_key")
  contentType    String         @map("content_type")
  byteSize       Int            @map("byte_size")
  alt            String
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  ogEntries      ContentEntry[] @relation("EntryOgImage")
  coverEntries   ContentEntry[] @relation("EntryCoverImage")

  @@index([organizationId])
  @@map("media")
}

model ContentAccess {
  organizationId String       @id @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  publicKeyHash  String?      @map("public_key_hash")
  publicKeyLast4 String?      @map("public_key_last4")
  webhookUrl     String?      @map("webhook_url")
  webhookSecret  String?      @map("webhook_secret")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@map("content_access")
}
